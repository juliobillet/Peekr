# =========================================================
# APP
# =========================================================

NEXT_PUBLIC_APP_NAME="Peekr"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Domínios planejados
NEXT_PUBLIC_MAIN_DOMAIN="peekr.com.br"
NEXT_PUBLIC_ROOM_DOMAIN="peekr.tv"

# =========================================================
# SUPABASE
# =========================================================

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# =========================================================
# DATABASE
# =========================================================

DATABASE_URL=""

# =========================================================
# AUTH / SECURITY
# =========================================================

SESSION_SECRET=""
ADMIN_EMAILS=""

# =========================================================
# STORAGE
# =========================================================

SUPABASE_AVATARS_BUCKET="avatars"
SUPABASE_TEMP_FILES_BUCKET="peek-temp-files"

# =========================================================
# LIVEKIT
# =========================================================

LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# =========================================================
# PAYMENTS
# =========================================================

PAYMENT_PROVIDER="stripe"

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Futuro, caso seja necessário trocar ou adaptar o provedor:
MERCADO_PAGO_ACCESS_TOKEN=""
ASAAS_API_KEY=""
PAGARME_API_KEY=""

# =========================================================
# EMAIL
# =========================================================

EMAIL_PROVIDER="resend"

RESEND_API_KEY=""
EMAIL_FROM="Peekr <noreply@peekr.com.br>"

# =========================================================
# CRON / INTERNAL JOBS
# =========================================================

CRON_SECRET=""

# =========================================================
# MODERATION
# =========================================================

MAX_CONFIRMED_STRIKES_PER_CATEGORY="3"
SEVERE_REPORT_AUTO_SUSPEND="true"

# =========================================================
# FEATURE FLAGS
# =========================================================

NEXT_PUBLIC_ENABLE_PAYMENTS="false"
NEXT_PUBLIC_ENABLE_LIVEKIT="false"
NEXT_PUBLIC_ENABLE_EMAILS="false"
NEXT_PUBLIC_ENABLE_MESSAGES="true"
NEXT_PUBLIC_ENABLE_REPORTS="true"
NEXT_PUBLIC_ENABLE_TEMP_FILES="false"
NEXT_PUBLIC_ENABLE_HEALTH_VERTICAL="false"
